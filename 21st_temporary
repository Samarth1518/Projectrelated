    if found_status is None:
        warnings.append(
            "STEP " + step_id +
            " has no confidently detected status; it was not classified."
        )
    elif found_status == "failure" and extra:
        description = (description + ", " + extra).strip(", ")

    return found_status, description


def extract_steps(block, include_modes=False):
    status = {name: [] for name in STATUS_NAMES}
    descriptions = {}
    warnings = []

    mode_status = {
        mode: {name: [] for name in STATUS_NAMES}
        for mode in ("auto", "manual")
    }
    auto_date_time_status = []

    # Ignore mode-like text before the STEP table.
    current_mode = "manual"
    table_started = False
    rows = []
    current_id = None
    current_lines = []
    current_step_mode = "manual"

    for raw_line in block.splitlines():
        line = raw_line.strip()
        if not line:
            continue

        if not table_started:
            if re.search(r"\bSTEP\s+ID\b", line, re.IGNORECASE):
                table_started = True
            continue

        if is_mode_line(line):
            if current_id is not None:
                rows.append((current_id, current_lines, current_step_mode))
                current_id, current_lines = None, []

            mode, info = parse_mode_line(line)
            if mode:
                current_mode = mode
                if mode == "auto":
                    if info["date_time"] and info["status"]:
                        auto_date_time_status.append({
                            "date_time": info["date_time"],
                            "status": info["status"]
                        })
                    else:
                        warnings.append(
                            "MODE AUTO row has missing or unrecognized "
                            "timestamp/status."
                        )
            continue

        match = STEP_ID_RE.match(line)
        if match:
            if current_id is not None:
                rows.append((current_id, current_lines, current_step_mode))

            current_id = match.group(1)
            remainder = line[match.end():].strip()
            current_lines = [remainder] if remainder else []
            current_step_mode = current_mode
        elif current_id is not None:
            current_lines.append(line)

    if current_id is not None:
        rows.append((current_id, current_lines, current_step_mode))

    seen_ids = set()
    for step_id, row_lines, step_mode in rows:
        if step_id in seen_ids:
            warnings.append(
                "Duplicate STEP ID " + step_id +
                " found within one procedure execution."
            )
        seen_ids.add(step_id)

        step_status, description = parse_step_row(
            step_id, row_lines, warnings
        )
        descriptions[step_id] = description

        if step_status in STATUS_NAMES:
            status[step_status].append(step_id)
            mode_status[step_mode][step_status].append(step_id)

    if include_modes:
        return status, descriptions, warnings, {
            "auto": {
                "date_time_status": auto_date_time_status,
                **mode_status["auto"]
            },
            "manual": mode_status["manual"]
        }

    return status, descriptions, warnings


def parse_pdf_text(text, source_name="unknown PDF"):
    executions = []
    warnings = []
    blocks = split_procedure_blocks(text)

    if not blocks:
        warnings.append(
            source_name + ": no Procedure: headers were detected."
        )

    for index, block in enumerate(blocks, 1):
        name, date_time, duration = extract_metadata(block)

        if not name:
            warnings.append(
                source_name + " / execution " + str(index) +
                ": procedure name was not detected."
            )
        if not date_time:
            warnings.append(
                source_name + " / execution " + str(index) +
                ": header timestamp was not detected."
            )
        if duration is None:
            warnings.append(
                source_name + " / execution " + str(index) +
                ": duration was not detected."
            )

        status, descriptions, row_warnings, modes = extract_steps(
            block, include_modes=True
        )
        warnings.extend(
            source_name + " / execution " + str(index) + ": " + w
            for w in row_warnings
        )

        if status["failure"]:
            final_status = "Failure"
            final_reason = [
                {sid: descriptions.get(sid, "")}
                for sid in status["failure"]
            ]
            for sid in status["failure"]:
                if not descriptions.get(sid, ""):
                    warnings.append(
                        source_name + ": failed STEP " + sid +
                        " has no extracted description."
                    )
        elif any(
            "has no confidently detected status" in w
            for w in row_warnings
        ):
            # Avoid claiming success when extraction is incomplete.
            final_status = "Unknown"
            final_reason = "Unable to determine reliably"
        else:
            final_status = "Success"
            final_reason = "None"

        executions.append({
            "Procedure Name": name,
            "date_time": date_time or "",
            "Dur": duration if duration is not None else 0,
            "Status": status,
            "final_status": final_status,
            "final_status_reason": final_reason,
            "mode_executions": modes
        })

    return executions, warnings


def validate_execution(execution):
    issues = []
    status = execution.get("Status", {})

    for name in STATUS_NAMES:
        if not isinstance(status.get(name), list):
            issues.append("Status key '" + name + "' is missing or invalid.")

    all_ids = [
        sid for name in STATUS_NAMES
        for sid in status.get(name, [])
    ]
    if len(all_ids) != len(set(all_ids)):
        issues.append("A STEP ID appears more than once across status categories.")

    if execution.get("final_status") not in ("Failure", "Success", "Unknown"):
        issues.append("Invalid final_status value.")

    if status.get("failure") and execution.get("final_status") != "Failure":
        issues.append("A failed STEP exists but final_status is not Failure.")

    if not status.get("failure") and execution.get("final_status") == "Failure":
        issues.append("final_status is Failure but no failed STEP was detected.")

    return issues
    

