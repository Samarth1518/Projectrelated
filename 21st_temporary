import re
from datetime import datetime

STATUS_NAMES = ("success", "failure", "suspend", "progress")

MONTHS = {
    "jan": 1, "feb": 2, "mar": 3, "apr": 4,
    "may": 5, "jun": 6, "jul": 7, "aug": 8,
    "sep": 9, "oct": 10, "nov": 11, "dec": 12
}

STEP_ID_RE = re.compile(
    r"^\s*(?!99\.999\b)(\d{2}\.\d{3,4})\b"
)

MODE_LINE_RE = re.compile(
    r"^\s*MODE\s+(AUTO|MANUAL)\b",
    re.IGNORECASE
)

DATE_TIME_RE = re.compile(
    r"(?<!\d)(\d{1,2})[-/]([A-Za-z]{3}|\d{1,2})[-/](\d{4})"
    r"\s+(\d{1,2}):(\d{2}):(\d{2})[:.](\d{1,3})(?!\d)",
    re.IGNORECASE
)

DATE_RE = re.compile(
    r"(?<!\d)\d{1,2}[-/](?:[A-Za-z]{3}|\d{1,2})[-/]\d{4}(?!\d)",
    re.IGNORECASE
)

TIME_RE = re.compile(
    r"(?<!\d)\d{1,2}:\d{2}:\d{2}[:.]\d{1,3}(?!\d)"
)

DURATION_RE = re.compile(
    r"\bDur\s*:\s*(\d+(?:\.\d+)?)\s*\(s\)",
    re.IGNORECASE
)

STATUS_RE = re.compile(
    r"^(Success|Failure|Suspend|Progress)$",
    re.IGNORECASE
)

STATUS_SUFFIX_RE = re.compile(
    r"\b(Success|Failure|Suspend|Progress)\s*$",
    re.IGNORECASE
)


def normalize_procedure_name(name):
    return re.sub(r"\s+", " ", (name or "").strip()).lower()


def normalize_datetime(value):
    match = DATE_TIME_RE.search(value or "")

    if not match:
        return None

    day, month_text, year, hour, minute, second, millis = (
        match.groups()
    )

    if month_text.isdigit():
        month = int(month_text)
    else:
        month = MONTHS.get(month_text.lower()[:3])

    if not month or not 1 <= month <= 12:
        return None

    try:
        parsed = datetime(
            int(year),
            month,
            int(day),
            int(hour),
            int(minute),
            int(second)
        )
    except ValueError:
        return None

    millis = millis[:3].ljust(3, "0")

    return (
        parsed.strftime("%Y-%m-%d %H:%M:%S")
        + "."
        + millis
    )


def split_procedure_blocks(text):
    matches = list(
        re.finditer(r"\bProcedure\s*:", text, re.IGNORECASE)
    )

    blocks = []

    for index, match in enumerate(matches):
        start = match.start()

        end = (
            matches[index + 1].start()
            if index + 1 < len(matches)
            else len(text)
        )

        blocks.append(text[start:end])

    return blocks


def extract_metadata(block):
    name_match = re.search(
        r"\bProcedure\s*:\s*(.*?)\s+\bTime\s*:",
        block,
        re.IGNORECASE | re.DOTALL
    )

    name = ""

    if name_match:
        name = re.sub(
            r"\s+", " ", name_match.group(1)
        ).strip()

    # Extract metadata only from the procedure header.
    table_match = re.search(
        r"\bSTEP\s+ID\b", block, re.IGNORECASE
    )

    header = (
        block[:table_match.start()]
        if table_match
        else block
    )

    time_match = DATE_TIME_RE.search(header)

    date_time = (
        normalize_datetime(time_match.group(0))
        if time_match
        else None
    )

    duration_match = DURATION_RE.search(header)

    duration = (
        int(float(duration_match.group(1)))
        if duration_match
        else None
    )

    return name, date_time, duration


def remove_date_time(value):
    value = DATE_TIME_RE.sub(" ", value)
    value = DATE_RE.sub(" ", value)
    value = TIME_RE.sub(" ", value)

    return re.sub(r"\s+", " ", value).strip()


def is_mode_line(line):
    return bool(MODE_LINE_RE.match(line or ""))


def parse_mode_line(line):
    match = MODE_LINE_RE.match(line or "")

    if not match:
        return None, None

    mode = match.group(1).lower()

    time_match = DATE_TIME_RE.search(line)

    date_time = (
        normalize_datetime(time_match.group(0))
        if time_match
        else None
    )

    status_match = STATUS_SUFFIX_RE.search(line)

    mode_status = (
        status_match.group(1).capitalize()
        if status_match
        else None
    )

    return mode, {
        "date_time": date_time,
        "status": mode_status
    }


def parse_step_row(step_id, row_lines, warnings):
    description_parts = []
    additional_failure_parts = []

    found_status = None
    description_finished = False

    for raw_line in row_lines:
        line = raw_line.strip()

        if not line:
            continue

        if is_mode_line(line):
            continue

        if re.fullmatch(r"[\s\-_=*|]+", line):
            continue

        # Detect a status on its own line.
        standalone_status = STATUS_RE.match(line)

        if standalone_status:
            found_status = standalone_status.group(1).lower()
            continue

        # Detect a status at the end of a table row.
        suffix_match = STATUS_SUFFIX_RE.search(line)

        has_date_or_time = bool(
            DATE_RE.search(line) or TIME_RE.search(line)
        )

        if suffix_match and has_date_or_time:
            found_status = suffix_match.group(1).lower()
            line = line[:suffix_match.start()].strip()

        date_match = DATE_RE.search(line)
        time_match = TIME_RE.search(line)

        positions = []

        if date_match:
            positions.append(date_match.start())

        if time_match:
            positions.append(time_match.start())

        if positions:
            # The timestamp separates the short description
            # from any additional text on the same line.
            boundary = min(positions)

            before_time = line[:boundary].strip()
            after_time = line[boundary:].strip()

            if before_time and not description_finished:
                cleaned = STEP_ID_RE.sub(
                    "", before_time
                ).strip()

                if cleaned:
                    description_parts.append(cleaned)

            cleaned = remove_date_time(after_time)

            cleaned = STATUS_SUFFIX_RE.sub(
                "", cleaned
            ).strip()

            cleaned = STEP_ID_RE.sub(
                "", cleaned
            ).strip()

            if cleaned:
                additional_failure_parts.append(cleaned)

            description_finished = True
            continue

        cleaned = remove_date_time(line)
        cleaned = STEP_ID_RE.sub("", cleaned).strip()

        if not cleaned:
            continue

        if not description_finished:
            description_parts.append(cleaned)
        else:
            # Preserve continuation lines until the next STEP
            # or MODE row. Include these in the reason if failed.
            additional_failure_parts.append(cleaned)

    description = re.sub(
        r"\s+", " ", " ".join(description_parts)
    ).strip()

    additional_failure_text = re.sub(
        r"\s+", " ", " ".join(additional_failure_parts)
    ).strip()

    if found_status == "failure" and additional_failure_text:
        description = (
            description + ", " + additional_failure_text
            if description
            else additional_failure_text
        )

    if found_status is None:
        warnings.append(
            "STEP " + step_id
            + " has no confidently detected status; "
            + "it was not added to a status list."
        )

    return found_status, description


def extract_steps(block, include_modes=False):
    status = {
        name: [] for name in STATUS_NAMES
    }

    descriptions = {}
    warnings = []

    mode_status = {
        "auto": {
            name: [] for name in STATUS_NAMES
        },
        "manual": {
            name: [] for name in STATUS_NAMES
        }
    }

    auto_date_time_status = []

    # Every procedure starts in Manual mode.
    current_mode = "manual"

    lines = block.splitlines()

    table_started = False
    rows = []
    current_id = None
    current_lines = []
    current_step_mode = "manual"

    for raw_line in lines:
        line = raw_line.strip()

        if not line:
            continue

        # Ignore header content before the STEP table.
        if (
            not table_started
            and re.search(
                r"\bSTEP\s+ID\b", line, re.IGNORECASE
            )
        ):
            table_started = True
            continue

        if not table_started:
            continue

        # A MODE row closes the previous STEP and changes
        # the mode for subsequent STEP rows.
        if is_mode_line(line):
            if current_id is not None:
                rows.append(
                    (
                        current_id,
                        current_lines,
                        current_step_mode
                    )
                )

                current_id = None
                current_lines = []

            mode, mode_info = parse_mode_line(line)

            if mode:
                current_mode = mode

                if mode == "auto":
                    auto_date_time_status.append({
                        "date_time": (
                            mode_info["date_time"] or ""
                        ),
                        "status": (
                            mode_info["status"] or ""
                        )
                    })

                    if (
                        not mode_info["date_time"]
                        or not mode_info["status"]
                    ):
                        warnings.append(
                            "MODE AUTO row has a missing or "
                            "unrecognized timestamp/status."
                        )

            continue

        step_match = STEP_ID_RE.match(line)

        if step_match:
            if current_id is not None:
                rows.append(
                    (
                        current_id,
                        current_lines,
                        current_step_mode
                    )
                )

            current_id = step_match.group(1)

            remainder = line[step_match.end():].strip()

            current_lines = (
                [remainder] if remainder else []
            )

            current_step_mode = current_mode

        elif current_id is not None:
            # Keep continuation lines with the current STEP.
            current_lines.append(line)

    if current_id is not None:
        rows.append(
            (
                current_id,
                current_lines,
                current_step_mode
            )
        )

    seen_ids = set()

    for step_id, row_lines, step_mode in rows:
        if step_id in seen_ids:
            warnings.append(
                "Duplicate STEP ID " + step_id
                + " found within one procedure execution."
            )

        seen_ids.add(step_id)

        step_status, description = parse_step_row(
            step_id,
            row_lines,
            warnings
        )

        descriptions[step_id] = description

        if step_status in STATUS_NAMES:
            status[step_status].append(step_id)

            mode_status[step_mode][step_status].append(
                step_id
            )

    if include_modes:
        mode_executions = {
            "auto": {
                "date_time_status": auto_date_time_status,
                **mode_status["auto"]
            },
            "manual": mode_status["manual"]
        }

        return (
            status,
            descriptions,
            warnings,
            mode_executions
        )

    # Preserve the original three-value return for callers
    # that do not request mode information.
    return status, descriptions, warnings


def parse_pdf_text(text, source_name="unknown PDF"):
    executions = []
    warnings = []

    blocks = split_procedure_blocks(text)

    if not blocks:
        warnings.append(
            source_name
            + ": no Procedure: headers were detected."
        )

    for index, block in enumerate(blocks, 1):
        name, date_time, duration = extract_metadata(block)

        if not name:
            warnings.append(
                source_name + ": execution "
                + str(index) + " has no procedure name."
            )

        if date_time is None:
            warnings.append(
                source_name + ": execution "
                + str(index)
                + " has an unrecognized header timestamp."
            )

        if duration is None:
            warnings.append(
                source_name + ": execution "
                + str(index)
                + " has an unrecognized duration."
            )

        (
            status,
            descriptions,
            row_warnings,
            mode_executions
        ) = extract_steps(block, include_modes=True)

        for warning in row_warnings:
            warnings.append(
                source_name + " / execution "
                + str(index) + ": " + warning
            )

        if status["failure"]:
            final_status = "Failure"

            final_reason = [
                {
                    step_id: descriptions.get(step_id, "")
                }
                for step_id in status["failure"]
            ]

            for step_id in status["failure"]:
                if not descriptions.get(step_id, ""):
                    warnings.append(
                        source_name + ": failed STEP "
                        + step_id
                        + " has no extracted description."
                    )
        else:
            final_status = "Success"
            final_reason = "None"

        executions.append({
            "Procedure Name": name,
            "date_time": date_time if date_time else "",
            "Dur": duration if duration is not None else 0,
            "Status": status,
            "final_status": final_status,
            "final_status_reason": final_reason,
            "mode_executions": mode_executions
        })

    return executions, warnings


def validate_execution(execution):
    issues = []
    status = execution.get("Status", {})

    for name in STATUS_NAMES:
        if (
            name not in status
            or not isinstance(status[name], list)
        ):
            issues.append(
                "Status key '" + name
                + "' is missing or invalid."
            )

    all_ids = []

    for name in STATUS_NAMES:
        all_ids.extend(status.get(name, []))

    if len(all_ids) != len(set(all_ids)):
        issues.append(
            "A STEP ID appears more than once "
            "across status categories."
        )

    if execution.get("final_status") not in (
        "Failure", "Success"
    ):
        issues.append(
            "final_status must be Failure or Success."
        )

    if (
        status.get("failure")
        and execution.get("final_status") != "Failure"
    ):
        issues.append(
            "A failed STEP exists but final_status "
            "is not Failure."
        )

    if (
        not status.get("failure")
        and execution.get("final_status") != "Success"
    ):
        issues.append(
            "No failed STEP exists but final_status "
            "is not Success."
        )

    return issues
    
